; A1200 with the normal (non-threaded) build: AGA, Paula and the static title
; menu, like OpenRCT2-A1200, but starting bin/openrct2 instead of the
; experimental threaded/LAN executable. Start in the game drawer.
.key RCT2DIR
.def RCT2DIR "RCT2:"
Failat 21
SetEnv OPENRCT2_AUDIO PAULA
SetEnv OPENRCT2_SKIP_TITLE 1
; 64 px paint columns: each map tile set up once per column (about 5% less drawing time).
SetEnv OPENRCT2_PAINT_COLUMN 64
Execute OpenRCT2-AGA "<RCT2DIR>"
UnsetEnv OPENRCT2_PAINT_COLUMN
UnsetEnv OPENRCT2_SKIP_TITLE
UnsetEnv OPENRCT2_AUDIO
